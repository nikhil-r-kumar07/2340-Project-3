# Copy this file to .env and fill in your values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# LLM (any OpenAI-compatible chat API). Swap providers by changing these lines only.
# Groq (default, free): get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b
# Fallback model on Groq (separate rate limit):
# LLM_MODEL=llama-3.3-70b-versatile

# Optional: only used by reasoning models like gpt-oss. Leave blank for Llama.
LLM_REASONING_EFFORT=low

# Local alternative with Ollama (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-oss:20b
