# Copy to .env on PythonAnywhere and replace every CHANGE_ME value.

# Django
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
DEBUG=False
ALLOWED_HOSTS=medicarehelper.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://medicarehelper.pythonanywhere.com

# HTTPS security (enable only after the PythonAnywhere HTTPS site is active)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# This app uses a shared pythonanywhere.com parent domain, so it must not opt
# unrelated hostnames into HSTS subdomain coverage or the browser preload list.
SILENCED_SYSTEM_CHECKS=security.W005,security.W021

# Persistent storage
DATABASE_PATH=/home/medicarehelper/2340-Project-3/db.sqlite3
DATA_DIR=/home/medicarehelper/2340-Project-3/data
CHROMA_DIR=/home/medicarehelper/2340-Project-3/chroma_db
EMBED_CACHE_DIR=/home/medicarehelper/2340-Project-3/.model_cache

# LLM
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# RAG
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.45
